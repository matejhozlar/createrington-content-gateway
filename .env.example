# The gateway reads plain environment variables and never opens this file itself:
# export them, or pass the file with `docker run --env-file .env`.
# An empty value counts as unset. The README's configuration table has the details.

# Required. The CurseForge API key every call to CurseForge is made with
# (https://console.curseforge.com/). Keep the gateway on loopback or a private
# network: anyone who can reach it can spend this key.
CURSEFORGE_API_KEY=

# What the gateway calls itself to Modrinth, which asks for a name and a way to
# reach you, such as `my-app/1.0 (https://example.com)`. Defaults to
# `content-gateway/<version>`.
MODRINTH_USER_AGENT=

# Where the gateway listens. Keep the host on loopback unless the network is private.
CONTENT_GATEWAY_HOST=127.0.0.1
CONTENT_GATEWAY_PORT=5005

# Log filter in tracing-subscriber EnvFilter syntax, such as `info` or
# `content_gateway=debug,info`.
CONTENT_GATEWAY_LOG=info

# Calls to CurseForge per minute over all consumers and pools. The ceiling
# against a runaway loop; CurseForge's own limit depends on your key.
CONTENT_GATEWAY_BUDGET_PER_MINUTE=300

# Calls to Modrinth per minute over all consumers and pools. Modrinth allows
# 300 per address.
CONTENT_GATEWAY_MODRINTH_PER_MINUTE=300

# UTC days of daily counts `/v1/budget` keeps, 1 to 3660. A day takes a few
# hundred bytes per pool.
CONTENT_GATEWAY_BUDGET_HISTORY_DAYS=90

# Who may call the gateway. Set exactly one of the two:
#
# CONTENT_GATEWAY_TOKEN: the bearer token of a single consumer named `default`
# with one pool named `default`, at least 32 characters
# (`openssl rand -base64 32` makes one).
#
# CONTENT_GATEWAY_CONSUMERS: several consumers as JSON, each with its own token
# and the budget pools it draws from, so calls are counted per purpose:
#   [{"name":"app","token":"...","pools":["launcher","app"]},{"name":"jobs","token":"...","pools":["jobs"]}]
# Names and pools are lowercase letters, digits and `-`. A request from a token
# with more than one pool sends `X-Budget-Pool: <pool>`.
CONTENT_GATEWAY_TOKEN=
#CONTENT_GATEWAY_CONSUMERS=

# Optional. Redis that keeps the minute's count, the 429 hold, the daily counts
# and the cached answers across restarts, such as
# `redis://:password@127.0.0.1:6379/0`. Without it everything stays in memory.
# Give the gateway a Redis of its own with `maxmemory` and `volatile-lru`.
REDIS_URL=
