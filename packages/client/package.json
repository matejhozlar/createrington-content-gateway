{
  "name": "@createrington/content-gateway-client",
  "version": "0.2.0",
  "description": "Typed client for content-gateway: the gateway's own routes from its OpenAPI document, the CurseForge passthrough with the budget's refusals handled, and loose zod schemas for the CurseForge answers consumers read.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matejhozlar/createrington-content-gateway.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "registry": "https://gitea.matejhoz.com/api/packages/createrington/npm/",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
